+// A floating window with a top decoration (hyprbars) joins it with a square edge.
+bool CWindowPresentation::squareTopCorners() {
+    if (!m_window.isFloating() || rounding() <= 0)
+        return false;
+
+    const auto WINDOW = m_window.m_self.lock();
+    if (!WINDOW)
+        return false;
+
+    const auto TOPDECO = m_window.getWindowMainSurfaceBox().y - g_pDecorationPositioner->getBoxWithIncludedDecos(WINDOW).y;
+    return TOPDECO > borderSize() + 0.5;
+}
