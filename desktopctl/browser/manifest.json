{
  "manifest_version": 3,
  "name": "AirDrop",
  "description": "Share the selection, a link or the page with iPhones nearby.",
  "version": "1.0",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
